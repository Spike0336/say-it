<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Say It!</title>
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#fff7d6">
<meta name="mobile-web-app-capable" content="yes">
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);--bg:#fff7d6;--card:#fff;--ink:#3b2f63}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#fff7d6;--card:#fff;--ink:#3b2f63}}
:root[data-theme="dark"]{--bg:#fff7d6;--card:#fff;--ink:#3b2f63}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;user-select:none}
html,body{height:100%;margin:0}
body{background:var(--bg);color:var(--ink);font-family:"Baloo 2","Comic Sans MS","Trebuchet MS",system-ui,sans-serif;overflow:hidden}
#app{height:100%;display:flex;flex-direction:column;padding:12px}
header{display:flex;justify-content:space-between;align-items:center;font-size:28px;font-weight:800}
#stars{background:#ffe066;border-radius:99px;padding:4px 16px}
#grid{flex:1;display:grid;grid-template-columns:repeat(2,1fr);grid-auto-rows:1fr;gap:12px;margin:10px 0;min-height:0}
@media (orientation:landscape){#grid{grid-template-columns:repeat(3,1fr)}}
.card{background:var(--card);border-radius:28px;border:6px solid;display:flex;align-items:center;justify-content:center;font-size:min(22vw,22vh);box-shadow:0 8px 0 rgba(0,0,0,.12);cursor:pointer;transition:transform .1s}
.card:active{transform:scale(.93)}
#overlay{position:fixed;inset:0;background:rgba(255,247,214,.97);display:none;flex-direction:column;align-items:center;justify-content:center;gap:10px;z-index:5;padding:20px;text-align:center}
#overlay.on{display:flex}
#big{font-size:min(45vw,38vh);line-height:1}
#big.bounce{animation:bounce .6s infinite alternate}
@keyframes bounce{to{transform:translateY(-18px) scale(1.06)}}
#mic{width:110px;height:110px;border-radius:50%;background:#e63946;display:flex;align-items:center;justify-content:center;font-size:56px;animation:pulse 1s infinite}
#mic.off{background:#bbb;animation:none}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(230,57,70,.6)}100%{box-shadow:0 0 0 40px rgba(230,57,70,0)}}
#msg{font-size:34px;font-weight:800;min-height:44px}
.small{position:fixed;bottom:calc(8px + env(safe-area-inset-bottom,0px));font-size:14px;opacity:.55;border:2px solid var(--ink);background:transparent;color:var(--ink);border-radius:12px;padding:6px 10px;z-index:9}
#parent{right:8px}#close{left:8px}
.conf{position:fixed;top:-60px;font-size:36px;z-index:20;pointer-events:none;animation:fall linear forwards}
@keyframes fall{to{transform:translateY(115vh) rotate(720deg)}}
#cheer{position:fixed;inset:0;display:none;align-items:center;justify-content:center;z-index:15;font-size:min(16vw,90px);font-weight:900;color:#e63946;text-shadow:0 4px 0 #fff,0 0 30px #ffe066;pointer-events:none;text-align:center}
#cheer.on{display:flex;animation:pop .5s ease-out}
@keyframes pop{from{transform:scale(.2)}to{transform:scale(1)}}
#foot{display:flex;justify-content:center;padding-bottom:4px}
#favbtn{font:inherit;font-size:14px;opacity:.5;border:2px solid var(--ink);background:transparent;color:var(--ink);border-radius:14px;padding:6px 14px}
#picker{position:fixed;inset:0;background:var(--bg);z-index:30;display:none;flex-direction:column;padding:12px;padding-top:calc(12px + env(safe-area-inset-top,0px));gap:8px}
#picker.on{display:flex}
#picker h2{margin:0;font-size:24px}
.prow{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.pb{font:inherit;font-size:16px;font-weight:700;border:3px solid var(--ink);background:#fff;color:var(--ink);border-radius:14px;padding:8px 14px}
.pb.on{background:#51cf66}
#pq{user-select:text;font:inherit;font-size:16px;flex:1;min-width:120px;border:3px solid var(--ink);border-radius:14px;padding:8px 12px;background:#fff;color:var(--ink)}
#plist{flex:1;overflow:auto;display:grid;grid-template-columns:repeat(auto-fill,minmax(84px,1fr));gap:8px;align-content:start}
.pi{background:#fff;border:4px solid #ddd;border-radius:16px;text-align:center;padding:6px 2px;cursor:pointer}
.pi span{font-size:38px;display:block}.pi small{font-size:13px;font-weight:700}
.pi.sel{border-color:#2f9e44;background:#d3f9d8}
</style>
</head>
<body>
<div id="app">
  <header><span>🗣️ Say It!</span><span id="stars">⭐ 0</span></header>
  <div id="grid"></div>
  <div id="foot"><button id="favbtn">⚙️ grown-ups: hold here</button></div>
</div>
<div id="overlay">
  <div id="big"></div>
  <div id="mic">🎤</div>
  <div id="msg"></div>
  <button class="small" id="close">✖ back</button>
  <button class="small" id="parent" title="Parent: count it as correct">grown-up: he said it ✓</button>
</div>
<div id="picker">
  <h2>⭐ My favourites <small id="pcount"></small></h2>
  <div class="prow"><span>Show:</span><button class="pb" id="m-all">All words</button><button class="pb" id="m-fav">Favourites only</button></div>
  <div class="prow"><input id="pq" placeholder="Search a word…"><button class="pb" id="pclear">Clear</button><button class="pb on" id="pdone">Done ✓</button></div>
  <div id="plist"></div>
</div>
<div id="cheer">🎉 WELL DONE! 🎉</div>

<script>
const ITEMS=[
 ["🐱","cat",["kitty","kitten","meow","cap","cut","kat"]],
 ["🐶","dog",["doggy","puppy","woof","dock","dig"]],
 ["⚽","ball",["bar","bell","boo","bo","bow"]],
 ["🐮","cow",["moo","cows","cao"]],
 ["🍎","apple",["apple","app","apples","ap"]],
 ["🍌","banana",["nana","nanna","bana","bananas","nan"]],
 ["🚗","car",["cars","cah","kar","brum","vroom"]],
 ["🦆","duck",["quack","dock","duk","duct"]],
 ["☀️","sun",["son","sunny","sung","some"]],
 ["🥛","milk",["mook","milky","mick","mil"]],
 ["🐑","sheep",["baa","sheep","ship","shape","sheet"]],
 ["🌙","moon",["moo","mon","mood","soon"]],
 ["🍞","bread",["bed","bred","bread","brad"]],
 ["🐟","fish",["fishy","fits","fash","fist"]],
 ["🚌","bus",["buss","bust","bas","bass"]],
 ["🐴","horse",["horsey","hoarse","hors","house","neigh"]]
];
const RAW=("🐷 pig 🐔 chicken 🐰 rabbit 🐻 bear 🐘 elephant 🦁 lion 🐯 tiger 🐵 monkey 🐸 frog 🐢 turtle 🦋 butterfly 🐝 bee 🐞 ladybird 🐜 ant 🕷️ spider 🐌 snail 🐛 caterpillar 🦉 owl 🐧 penguin 🦒 giraffe 🦓 zebra 🐊 crocodile 🐍 snake 🐙 octopus 🦀 crab 🐬 dolphin 🐳 whale 🦈 shark 🐭 mouse 🐹 hamster 🦔 hedgehog 🦊 fox 🐺 wolf 🐿️ squirrel 🦢 swan 🦅 eagle 🐣 chick 🦜 parrot 🦘 kangaroo 🐪 camel 🦌 deer 🐐 goat 🦙 llama 🦛 hippo 🦏 rhino 🐼 panda 🐨 koala 🦥 sloth 🦩 flamingo 🦄 unicorn 🐉 dragon 🪱 worm 🪰 fly 🐚 shell 🦞 lobster 🦇 bat "+
"🍓 strawberry 🍇 grapes 🍊 orange 🍋 lemon 🍐 pear 🍑 peach 🍒 cherries 🍉 watermelon 🍍 pineapple 🥝 kiwi 🥭 mango 🍅 tomato 🥕 carrot 🌽 corn 🥦 broccoli 🥒 cucumber 🥔 potato 🍄 mushroom 🥚 egg 🧀 cheese 🍕 pizza 🍔 burger 🍟 chips 🥪 sandwich 🍪 biscuit 🍰 cake 🧁 cupcake 🍩 doughnut 🍬 sweet 🍭 lollipop 🥞 pancakes 🍯 honey 🍿 popcorn 🥜 peanut 🥑 avocado 🥥 coconut 🧈 butter 🧃 juice 🍵 tea 💧 water 🍫 chocolate 🌭 hotdog 🍚 rice 🍝 spaghetti 🥣 bowl "+
"🪑 chair 🛏️ bed 🚪 door 🪟 window 🛁 bath 🚽 toilet 🪥 toothbrush 🧼 soap 🧸 teddy 🔑 key 📱 phone 💡 light 🕰️ clock 🪞 mirror 🧦 socks 👕 shirt 👖 jeans 👗 dress 👟 shoe 🎩 hat 🧤 gloves 🧣 scarf 👓 glasses ☂️ umbrella 🎒 bag 🥄 spoon 🍴 fork 🍽️ plate 🫖 teapot 🧹 broom 🪣 bucket 🛋️ sofa 🕯️ candle 🎁 present 🎈 balloon 📖 book ✏️ pencil 🖍️ crayon ✂️ scissors 🔔 bell 🎺 trumpet 🥁 drum 🎸 guitar 🎹 piano 🪁 kite 🧩 puzzle 🏠 house 🍼 bottle 🚿 shower 👑 crown 🤖 robot 👻 ghost "+
"🚂 train ✈️ plane 🚁 helicopter 🚀 rocket 🚢 ship ⛵ boat 🚲 bike 🛴 scooter 🚜 tractor 🚑 ambulance 🛻 truck 🚕 taxi 🏍️ motorbike 🌳 tree 🌸 flower 🌹 rose 🌻 sunflower 🍃 leaf 🌈 rainbow ☁️ cloud 🌧️ rain ⛄ snowman ❄️ snow ⭐ star 🔥 fire 🌊 wave 🏖️ beach ⛰️ mountain 🌋 volcano 🌍 world 🪨 rock 🏰 castle ⛺ tent 🌉 bridge "+
"👀 eyes 👃 nose 👂 ear 👄 mouth 👅 tongue 🦷 tooth 🖐️ hand 🦶 foot 🦴 bone 👶 baby ❤️ heart 🦵 leg 👍 thumb 🤡 clown 🧚 fairy 👽 alien 🧜 mermaid").split(/\s+/);
RAW.push(..."🦃 turkey 🦚 peacock 🦭 seal 🦦 otter 🐂 bull 🦎 lizard 🪲 beetle 🦗 cricket 🪸 coral 🐡 pufferfish 🦑 squid 🦐 prawn 🕊️ dove 🪶 feather 🌵 cactus 🌷 tulip 🌼 daisy 🪺 nest 🪵 log 🌅 sunrise 🌪️ tornado ⚡ lightning 💨 wind 🏝️ island 🏜️ desert 🥬 lettuce 🥗 salad 🧅 onion 🧄 garlic 🫑 pepper 🌶️ chilli 🫘 beans 🥯 bagel 🥨 pretzel 🥖 baguette 🍜 noodles 🍲 stew 🥧 pie 🍮 pudding 🧇 waffle 🥩 steak 🍖 meat 🌮 taco 🌯 burrito 🥫 can 🧂 salt 🧊 ice 🖼️ picture 📻 radio 📷 camera 💻 laptop ⌨️ keyboard 🔋 battery 🔌 plug 🧵 thread 🪡 needle 🧶 wool 📦 box ✉️ letter 🔒 lock 🧰 toolbox 🔧 spanner 🔨 hammer 🪚 saw 🪛 screwdriver 🪜 ladder 🛒 trolley 🪙 coin 💎 diamond 💍 ring 👛 purse 👜 handbag 🧳 suitcase ⌚ watch 🔦 torch 🧲 magnet 🔭 telescope 🔬 microscope 🪄 wand 🎀 ribbon 🎃 pumpkin 🎲 dice 🎯 target 🏆 trophy 🥇 medal 🏀 basketball 🎾 tennis ⛳ golf 🛹 skateboard 🎤 microphone 🎧 headphones 🎻 violin 🎷 saxophone 🩴 flipflop 👢 boot 🧥 coat 🩳 shorts 👔 tie 🧽 sponge 🧺 basket 🛗 lift 🚰 tap 🚐 van 🚚 lorry 🚤 speedboat ⚓ anchor 🧭 compass 🗺️ map 🏥 hospital 🏫 school 🏪 shop ⛪ church 🛣️ road 🧑‍🚀 astronaut 🧑‍🍳 chef 👸 princess 🤴 prince 🧙 wizard 🎅 santa 💃 dancer 🏃 runner 💋 kiss 👁️ eye 💩 poo 😀 smile 😴 sleep 👏 clap 💪 muscle 🔴 red 🔵 blue 🟢 green 🟡 yellow 🟣 purple 🟤 brown ⚫ black ⚪ white 🩷 pink ⭕ circle 🔺 triangle 🟦 square 1️⃣ one 2️⃣ two 3️⃣ three 4️⃣ four 5️⃣ five 6️⃣ six 7️⃣ seven 8️⃣ eight 9️⃣ nine 🔟 ten".split(" "));
const ALT={one:["won"],two:["too","to"],four:["for"],eight:["ate"],red:["read"],pink:["pinky"],pig:["piggy","oink"],rabbit:["bunny"],frog:["froggy","ribbit"],bee:["buzz"],train:["choo","choochoo"],plane:["aeroplane","airplane"],teddy:["ted"],chicken:["cluck"],bike:["bicycle"],tooth:["teeth"],foot:["feet"],mouse:["mice"],fly:["flies"],hat:["hats"]};
for(let i=0;i<RAW.length;i+=2){const w=RAW[i+1];ITEMS.push([RAW[i],w,[w+"s",...(ALT[w]||[])]])}
const COLORS=["#ff6b6b","#4dabf7","#51cf66","#fcc419","#cc5de8","#ff922b"];
let stars=0, current=null, rec=null, timer=null, busy=false;
const $=id=>document.getElementById(id);
function safeGet(k){try{return localStorage.getItem(k)}catch(e){return null}}
function safeSet(k,v){try{localStorage.setItem(k,v)}catch(e){}}
$("stars").textContent="⭐ "+stars;

function shuffle(a){return a.map(x=>[Math.random(),x]).sort((p,q)=>p[0]-q[0]).map(p=>p[1])}
let favs=[];try{favs=JSON.parse(safeGet("favs")||"[]")}catch(e){}
let mode=safeGet("mode")||"all";
function pool(){const f=ITEMS.filter(it=>favs.includes(it[1]));return shuffle(mode==="fav"&&f.length?f:ITEMS)}
function deal(){
  const g=$("grid");g.innerHTML="";
  pool().slice(0,6).forEach((it,i)=>{
    const d=document.createElement("div");d.className="card";
    d.style.borderColor=COLORS[i%COLORS.length];d.textContent=it[0];
    d.onclick=()=>openItem(it);g.appendChild(d);
  });
}

/* ---------- audio ---------- */
let ac=null;
function ctx(){if(!ac){try{ac=new (window.AudioContext||window.webkitAudioContext)()}catch(e){}}if(ac&&ac.state==="suspended")ac.resume();return ac}
function note(f,t,d,type="sawtooth",v=.18){
  const a=ctx();if(!a)return;
  const o=a.createOscillator(),g=a.createGain();
  o.type=type;o.frequency.value=f;
  g.gain.setValueAtTime(0,a.currentTime+t);
  g.gain.linearRampToValueAtTime(v,a.currentTime+t+.02);
  g.gain.exponentialRampToValueAtTime(.001,a.currentTime+t+d);
  o.connect(g);g.connect(a.destination);o.start(a.currentTime+t);o.stop(a.currentTime+t+d+.05);
}
function fanfare(){
  const C=523.25,E=659.25,G=783.99,hC=1046.5,hE=1318.5;
  [[C,0,.13],[C,.14,.13],[C,.28,.13],[G,.42,.35],[E,.8,.15],[G,.97,.15],[hC,1.14,.7]].forEach(n=>note(n[0],n[1],n[2]));
  [[C/2,.42,.35],[C/2,1.14,.8]].forEach(n=>note(n[0],n[1],n[2],"square",.1));
  [hC,hE,G*2].forEach((f,i)=>note(f,1.2+i*.08,.9,"triangle",.12));
  for(let i=0;i<10;i++)note(1500+Math.random()*1500,1.2+i*.08,.12,"sine",.06);
}
function boop(){note(440,0,.15,"sine",.2);note(660,.12,.2,"sine",.2)}
function oops(){note(330,0,.2,"triangle",.15);note(262,.2,.3,"triangle",.15)}
function say(text,rate=.8,pitch=1.3){
  try{const u=new SpeechSynthesisUtterance(text);u.lang="en-GB";u.rate=rate;u.pitch=pitch;speechSynthesis.cancel();speechSynthesis.speak(u)}catch(e){}
}
function confetti(){
  const E=["🎉","⭐","🎈","✨","🌈","💖","🎊","🦄"];
  for(let i=0;i<45;i++){
    const c=document.createElement("div");c.className="conf";c.textContent=E[i%E.length];
    c.style.left=Math.random()*100+"vw";c.style.animationDuration=(2+Math.random()*2.5)+"s";c.style.animationDelay=Math.random()*.8+"s";
    document.body.appendChild(c);setTimeout(()=>c.remove(),6000);
  }
}

/* ---------- speech matching ---------- */
function lev(a,b){const m=[];for(let i=0;i<=a.length;i++){m[i]=[i]}for(let j=0;j<=b.length;j++)m[0][j]=j;
  for(let i=1;i<=a.length;i++)for(let j=1;j<=b.length;j++)m[i][j]=Math.min(m[i-1][j]+1,m[i][j-1]+1,m[i-1][j-1]+(a[i-1]===b[j-1]?0:1));return m[a.length][b.length]}
function matches(heard,item){
  const targets=[item[1],...item[2]];
  const words=heard.toLowerCase().replace(/[^a-z\s]/g," ").split(/\s+/).filter(Boolean);
  return words.some(w=>targets.some(t=>w===t||(t.length>=4&&w.length>=4&&lev(w,t)<=1)));
}

/* ---------- flow ---------- */
function openItem(it){
  current=it;busy=false;
  $("big").textContent=it[0];$("big").className="";
  $("overlay").classList.add("on");
  boop();ctx();
  $("msg").textContent="That's a "+it[1]+"!";
  say(it[1]+"!");
  clearTimeout(timer);
  timer=setTimeout(listen,1100);
}
function closeItem(){
  clearTimeout(timer);stopRec();speechSynthesis&&speechSynthesis.cancel();
  $("overlay").classList.remove("on");current=null;
}
function stopRec(){try{rec&&rec.abort()}catch(e){}rec=null}
function listen(){
  if(!current)return;
  const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
  if(!SR){$("mic").classList.add("off");$("msg").textContent="Say \""+current[1]+"\"! (grown-up: tap the button)";return}
  stopRec();
  rec=new SR();rec.lang="en-GB";rec.interimResults=true;rec.maxAlternatives=5;rec.continuous=false;
  let done=false;
  $("mic").classList.remove("off");$("msg").textContent="Say \""+current[1]+"\"! 🎤";
  rec.onresult=e=>{
    if(done||!current)return;
    for(let i=e.resultIndex;i<e.results.length;i++){
      for(let j=0;j<e.results[i].length;j++){
        if(matches(e.results[i][j].transcript,current)){done=true;success();return}
      }
    }
    if(e.results[e.results.length-1].isFinal){done=true;tryAgain()}
  };
  rec.onerror=e=>{
    if(e.error==="not-allowed"||e.error==="service-not-allowed"){$("mic").classList.add("off");$("msg").textContent="Microphone is blocked 🙁 (grown-up: allow it, or tap the button)"}
    else if(!done&&current){done=true;tryAgain()}
  };
  rec.onend=()=>{if(!done&&current&&!busy){done=true;tryAgain()}};
  try{rec.start()}catch(e){}
}
function tryAgain(){
  if(!current||busy)return;
  oops();$("msg").textContent="Nearly! Try again: \""+current[1]+"\"";
  say("Try again. "+current[1]);
  clearTimeout(timer);timer=setTimeout(listen,1800);
}
function success(){
  if(busy||!current)return;busy=true;stopRec();clearTimeout(timer);
  fanfare();confetti();
  $("big").className="bounce";$("mic").classList.add("off");
  $("msg").textContent="You said "+current[1]+"! 🌟";
  $("cheer").classList.add("on");
  stars++;$("stars").textContent="⭐ "+stars;
  setTimeout(()=>say("Well done! "+current.slice(1,2)[0]+"!",.85,1.4),700);
  setTimeout(()=>{$("cheer").classList.remove("on")},3200);
  setTimeout(()=>{closeItem();deal()},4200);
}
$("close").onclick=closeItem;
$("parent").onclick=()=>{if(current)success()};
function setMode(m){mode=m;safeSet("mode",m);$("m-all").classList.toggle("on",m==="all");$("m-fav").classList.toggle("on",m==="fav")}
function updCount(){$("pcount").textContent="("+favs.length+" picked)"}
function renderPicker(){
  const q=$("pq").value.trim().toLowerCase(),box=$("plist");box.innerHTML="";
  ITEMS.filter(it=>!q||it[1].includes(q)).forEach(it=>{
    const d=document.createElement("div");d.className="pi"+(favs.includes(it[1])?" sel":"");
    d.innerHTML="<span>"+it[0]+"</span><small>"+it[1]+"</small>";
    d.onclick=()=>{const i=favs.indexOf(it[1]);
      if(i>=0){favs.splice(i,1)}else{favs.push(it[1]);if(favs.length===1)setMode("fav")}
      safeSet("favs",JSON.stringify(favs));d.classList.toggle("sel");updCount()};
    box.appendChild(d);
  });
}
function openPicker(){$("picker").classList.add("on");setMode(mode);renderPicker();updCount()}
$("pq").oninput=renderPicker;
$("m-all").onclick=()=>setMode("all");
$("m-fav").onclick=()=>setMode("fav");
$("pclear").onclick=()=>{favs=[];safeSet("favs","[]");renderPicker();updCount()};
$("pdone").onclick=()=>{$("picker").classList.remove("on");deal()};
const fb=$("favbtn");let ft;
fb.onpointerdown=()=>{ft=setTimeout(openPicker,700)};
["pointerup","pointerleave","pointercancel"].forEach(ev=>fb.addEventListener(ev,()=>clearTimeout(ft)));
fb.oncontextmenu=e=>e.preventDefault();
deal();
</script>
</body>
</html>
